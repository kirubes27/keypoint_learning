+def _pair_graph_is_one_complete_cycle(
+    pair_rows: Sequence[Mapping[str, Any]],
+    frame_ids: Sequence[Any],
+) -> bool:
+    """Return true only when the evaluated frames themselves form one cycle.
+
+    A corpus can be cyclic while a held-out subset is only a path.  Treating
+    the first and last held-out frames as adjacent would inflate close-run
+    durations and is therefore forbidden unless every evaluated frame has
+    exactly one incoming and one outgoing edge in one connected cycle.
+    """
+
+    frame_set = set(frame_ids)
+    if len(pair_rows) != len(frame_ids) or not frame_ids:
+        return False
+    source_to_target: dict[Any, Any] = {}
+    targets: set[Any] = set()
+    for row in pair_rows:
+        source = row["source_frame"]
+        target = row["target_frame"]
+        if (
+            source not in frame_set
+            or target not in frame_set
+            or source in source_to_target
+            or target in targets
+        ):
+            return False
+        source_to_target[source] = target
+        targets.add(target)
+    if set(source_to_target) != frame_set or targets != frame_set:
+        return False
+    start = frame_ids[0]
+    current = start
+    visited: set[Any] = set()
+    for _ in range(len(frame_ids)):
+        if current in visited:
+            return False
+        visited.add(current)
+        current = source_to_target[current]
+    return current == start and visited == frame_set
+
